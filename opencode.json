{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "smart-explore": {
      "type": "local",
      "command": [
        "smart-explore-mcp"
      ],
      "enabled": true
    }
  },
  "permission": {
    "edit": "ask",
    "apply_patch": "ask"
  },
  "instructions": [
    "rules.md"
  ],
  "provider": {
    "openai": {
      "models": {
        "gpt-5.5-flex": {
          "id": "gpt-5.5",
          "name": "gpt-5.5 FLEX",
          "cost": {
            "input": 2.5,
            "cache_read": 0.25,
            "output": 15,
            "context_over_200k": {
              "input": 5,
              "cache_read": 0.5,
              "output": 22.5
            }
          },
          "options": {
            "serviceTier": "flex"
          }
        },
        "gpt-5.4-flex": {
          "id": "gpt-5.4",
          "name": "gpt-5.4 FLEX",
          "cost": {
            "input": 1.25,
            "cache_read": 0.125,
            "output": 7.5,
            "context_over_200k": {
              "input": 2.5,
              "cache_read": 0.25,
              "output": 11.25
            }
          },
          "options": {
            "serviceTier": "flex"
          }
        },
        "gpt-5.4-mini-flex": {
          "id": "gpt-5.4-mini",
          "name": "gpt-5.4 mini FLEX",
          "cost": {
            "input": 0.375,
            "cache_read": 0.0375,
            "output": 2.25
          },
          "options": {
            "serviceTier": "flex"
          }
        }
      }
    }
  },
  "lsp": true,
  "plugin": [
    "./plugins_dist/oh-my-opencode-tool-only/index.ts",
    "./plugins/batch-tool-reminder.ts"
  ]
}
